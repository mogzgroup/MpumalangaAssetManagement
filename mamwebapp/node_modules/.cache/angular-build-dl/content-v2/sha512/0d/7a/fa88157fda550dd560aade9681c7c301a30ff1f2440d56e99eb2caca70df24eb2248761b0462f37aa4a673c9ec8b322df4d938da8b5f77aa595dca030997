n                        </td>\r\n                        <td>\r\n                            <p-inputNumber class=\"ui-inputtext ui-widget\" [(ngModel)]=\"operationPlan.cashFlowYear1\"\r\n                                [ngModelOptions]=\"{standalone: true}\" mode=\"currency\" currency=\"ZAR\" locale=\"en-ZA\">\r\n                            </p-inputNumber>\r\n                        </td>\r\n                        <td>\r\n                            <p-inputNumber class=\"ui-inputtext ui-widget\" [(ngModel)]=\"operationPlan.cashFlowYear2\"\r\n                                [ngModelOptions]=\"{standalone: true}\" mode=\"currency\" currency=\"ZAR\" locale=\"en-ZA\">\r\n                            </p-inputNumber>\r\n                        </td>\r\n                        <td>\r\n                            <p-inputNumber class=\"ui-inputtext ui-widget\" [(ngModel)]=\"operationPlan.cashFlowYear3\"\r\n                                [ngModelOptions]=\"{standalone: true}\" mode=\"currency\" currency=\"ZAR\" locale=\"en-ZA\">\r\n                            </p-inputNumber>\r\n                        </td>\r\n                        <td>\r\n                            <p-inputNumber class=\"ui-inputtext ui-widget\" [(ngModel)]=\"operationPlan.cashFlowYear4\"\r\n                                [ngModelOptions]=\"{standalone: true}\" mode=\"currency\" currency=\"ZAR\" locale=\"en-ZA\">\r\n                            </p-inputNumber>\r\n                        </td>\r\n                        <td>\r\n                            <p-inputNumber class=\"ui-inputtext ui-widget\" [(ngModel)]=\"operationPlan.cashFlowYear5\"\r\n                                [ngModelOptions]=\"{standalone: true}\" mode=\"currency\" currency=\"ZAR\" locale=\"en-ZA\">\r\n                            </p-inputNumber>\r\n                        </td>\r\n                        <td>{{calculateDbTotalAmountRequired(operationPlan) | currency:'ZAR':'R'}}</td>\r\n\r\n                    </tr>\r\n      