 });\r\n        this.ticketisFound = false;\r\n      });\r\n    }\r\n  }\r\n\r\n  getReferenceNumber(length): string {\r\n    let result = '';\r\n    const characters = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';\r\n    const charactersLength = characters.length;\r\n    for (let i = 0; i < length; i++) {\r\n      result += characters.charAt(Math.floor(Math.random() * charactersLength));\r\n    }\r\n    return result;\r\n  }\r\n}\r\n","<p-toast [style]=\"{marginTop: '80px'}\" position=\"top-right\"></p-toast>\r\n\r\n<div class=\"text-center\" style=\"color: red;\" *ngIf=\"error\">\r\n    <h5 class=\"mt-20\">\r\n        <li class=\"pi pi-exclamation-triangle\" style=\"color: red;font-size: xx-large;\"></li>\r\n        <span> An error has occured...</span>\r\n    </h5>\r\n    <h6 class=\"color-aqua\">{{errorMsg}}</h6>\r\n</div>\r\n\r\n<div>\r\n    <form [formGroup]=\"trackFaultForm\" style=\"height: auto;\">\r\n        <div class=\"p-fluid p-grid p-formgrid form-body\">\r\n            <div class=\"formgrid grid\">\r\n                <div class=\"field grid col-12\">\r\n                    <span class=\"p-input-icon-left p-1\">\r\n                        <label for=\"float-input\">Enter your reference number</label>\r\n                        <input [(ngModel)]=\"referenceNumber\" formControlName=\"referenceNumber\" autocomplete=\"off\" type=\"text\" pInputText class=\"ui-inputtext ui-widget\">\r\n                        <div *ngIf=\"submitted && f.referenceNumber.errors\" class=\"text-error\"><br>\r\n                            <div *ngIf=\"f.referenceNumber.errors.required\">This field is required.</div>\r\n                        </div>\r\n                    </span>\r\n                </div>                \r\n            </div>     \r\n        </div>\r\n    </form>\r\n    <br/>\r\n    <div style=\"text-align: center;\">        \r\n        <button type=\"button\" (click)=\"onSearch()\" pButton label=\"Search\"></button>      \r\n    </div>\r\n    <br/>\r\n    <div *ngIf